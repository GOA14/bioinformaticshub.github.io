source "https://rubygems.org"

# Mirrors the GitHub Pages build environment. For a plain local build you can
# use the `jekyll` gem directly instead.
gem "github-pages", group: :jekyll_plugins
gem "webrick", "~> 1.8"   # needed for `jekyll serve` on Ruby >= 3.0

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
end
